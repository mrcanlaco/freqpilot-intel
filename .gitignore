# Public source is an explicit allowlist. Operator files remain local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/NOTICE
!/CONTRIBUTING.md
!/SECURITY.md
!/pyproject.toml
!/.github/
!/src/
!/tests/
!/config/
/config/*
!/config/*.example.json
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/OPERATIONS.md
!/docs/DATA_POLICY.md
!/scripts/
/scripts/*
!/scripts/bootstrap.py
!/scripts/run.ps1
!/scripts/deploy-local.ps1
!/scripts/verify.ps1
!/ops/
/ops/*
!/ops/windows_supervisor.py
!/ops/register-startup.ps1
!/ops/cloudflared.example.yml
!/ops/msi-fetch-worker/
/ops/msi-fetch-worker/*
!/ops/msi-fetch-worker/*.py
!/ops/msi-fetch-worker/README.md
!/ops/msi-fetch-worker/CONTRACT.md

# Never publish runtime, credentials, captured corpora or generated reports.
**/runtime/
**/__pycache__/
**/node_modules/
**/.venv/
*.py[cod]
*.sqlite*
*.db
*.db-wal
*.db-shm
*.pem
*.key
.env
.env.*
*.log
.pytest_cache/
.coverage
.hermes-tmp.*
